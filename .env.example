# Neon (production / shared remote):
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
# Local Homebrew: postgresql://USER@localhost:5432/longhand?schema=public
# Docker: postgresql://longhand:longhand@localhost:5432/longhand?schema=public
SESSION_SECRET="replace-with-a-long-random-string"

SEED_USER_EMAIL="aspirant@localhost"
SEED_USER_PASSWORD="longhand"

# One line only — not the curl from the Anthropic docs.
ANTHROPIC_API_KEY="sk-ant-..."

# ElevenLabs Scribe (optional). Speak uses this when set; otherwise the browser.
ELEVENLABS_API_KEY=""

# PostHog. Project token starts with phc_ — not a personal phx_ key.
# Copy from Project settings → Project API key. On Vercel, add these as Config
# (not Sensitive, not NEXT_PUBLIC_). The server passes them to the browser SDK.
# POSTHOG_PROJECT_KEY="phc_..."
# POSTHOG_HOST="https://us.i.posthog.com"

# Cloudflare R2 for note photos (optional). Without these, photos are stored
# inline in the note. Create a bucket, enable its public r2.dev URL, then
# create an R2 API token with Object Read & Write on that bucket.
# CLOUDFLARE_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET="longhand"
# NEXT_PUBLIC_R2_PUBLIC_BASE_URL="https://pub-xxxxxxxx.r2.dev"
